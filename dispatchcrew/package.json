{
  "name": "dispatchcrew",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --env-file=.env server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --env-file=.env server/index.ts",
    "test": "vitest run",
    "seed": "tsx --env-file=.env server/seed.ts",
    "reset": "tsx --env-file=.env server/seed.ts --reset",
    "test:live": "tsx --env-file=.env scripts/live-check.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
