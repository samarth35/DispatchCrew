{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "server/migrations/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(assets|fonts|images)/.*",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    }
  ]
}
